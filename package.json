    "await-to-js": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^17.4.0",
    "graphql": "^15.4.0",
    "hds-core": "^6.0.5",
    "hds-design-tokens": "^6.0.5",
