  },
  "scripts": {
    "start": "pnpm run update-runtime-env && vite",
    "build": "vite build",
    "test": "cross-env TEST=true pnpm run update-runtime-env && vitest run",
    "test:coverage": "cross-env TEST=true pnpm run update-runtime-env && vitest run --coverage",
    "test:coverage-for-sonar": "pnpm test:coverage --reporter=junit --outputFile=reports/test-report.xml",
    "ci": "cross-env CI=true pnpm test:coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "update-runtime-env": "ts-node -P ./scripts/tsconfig.json --files scripts/update-runtime-env.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^5.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.0.1",
    "ts-node": "^10.9.2",
    "vitest": "^5.0.0"
  }
